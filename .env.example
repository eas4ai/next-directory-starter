# Use a persistent SQLite file. Replace this path for production deployments.
DATABASE_URL=file:./.runtime/directory.db
# Optional persistent private image directory; defaults beside the SQLite file.
MEDIA_DIR=
# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Public identity. Asset URLs may be site-relative paths or HTTP(S) URLs.
SITE_NAME=Directory Starter
SITE_DESCRIPTION=A curated directory of useful links.
SITE_LOGO_URL=
SITE_ICON_URL=
# Account email through Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM=
# Select which test or live plans owners can see and use.
BILLING_CHECKOUT_MODE=test
# Generate a separate 32-byte base64url key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BILLING_ENCRYPTION_KEY=
# Stripe secret key for hosted one-time Checkout. Set webhook signing secret after configuring the endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional operator-only credentials for read-only NOWPayments invoice reconciliation.
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
