{
  "schemaVersion": 1,
  "id": "renderer-addon",
  "name": "Renderer Add-on",
  "version": "1.0.0",
  "compatibility": {
    "starter": ">=1.2.0 <2.0.0",
    "addonApi": 1
  },
  "themes": [
    {
      "id": "renderer-addon",
      "name": "Renderer Add-on",
      "entry": "src/theme.ts"
    }
  ],
  "templates": [
    {
      "id": "renderer-addon",
      "name": "Renderer Grid",
      "renderer": "src/template.tsx",
      "templateApi": 1,
      "stylesheet": "src/template.css",
      "supportedProfiles": [
        {
          "id": "renderer-addon.ai-tools",
          "range": "^1.0.0"
        }
      ]
    }
  ],
  "assets": [
    "public/reference-mark.svg"
  ],
  "seed": "seed/catalog.json",
  "files": [
    "public/reference-mark.svg",
    "seed/catalog.json",
    "src/ai-tools.profile.json",
    "src/template.css",
    "src/template.tsx",
    "src/theme.ts"
  ],
  "profiles": [
    {
      "id": "renderer-addon.ai-tools",
      "version": "1.0.0",
      "schema": "src/ai-tools.profile.json"
    }
  ]
}
