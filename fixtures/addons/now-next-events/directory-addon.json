{
  "schemaVersion": 1,
  "id": "now-next-events",
  "name": "NOW/NEXT Events & Conferences",
  "version": "1.0.0",
  "compatibility": {
    "starter": ">=1.2.0 <2.0.0",
    "addonApi": 1
  },
  "themes": [
    {
      "id": "now-next-events",
      "name": "NOW/NEXT",
      "entry": "src/theme.ts"
    }
  ],
  "templates": [
    {
      "id": "now-next-events",
      "name": "NOW/NEXT Events & Conferences",
      "renderer": "src/template.tsx",
      "templateApi": 1,
      "stylesheet": "src/template.css",
      "supportedProfiles": [
        {
          "id": "now-next-events.events",
          "range": "^1.0.0"
        }
      ]
    }
  ],
  "profiles": [
    {
      "id": "now-next-events.events",
      "version": "1.0.0",
      "schema": "src/events.profile.json"
    }
  ],
  "assets": [
    "public/now-next-mark.svg"
  ],
  "seed": "seed/catalog.json",
  "files": [
    "docs/changelog.md",
    "docs/license.md",
    "docs/readme.md",
    "public/now-next-mark.svg",
    "seed/catalog.json",
    "seed/media/access-forward.webp",
    "seed/media/after-dark-sessions.webp",
    "seed/media/city-systems-closing.webp",
    "seed/media/commons-design-weekend.webp",
    "seed/media/form-function-forum.webp",
    "seed/media/hybrid-makers.webp",
    "seed/media/material-futures-lab.webp",
    "seed/media/remote-first-forum.webp",
    "seed/media/signal-rooftop.webp",
    "seed/media/type-public-life.webp",
    "src/events.profile.json",
    "src/template.css",
    "src/template.tsx",
    "src/theme.ts"
  ]
}
