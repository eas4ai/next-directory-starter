{
  "schemaVersion": 1,
  "id": "vector-ai-tools",
  "name": "VECTOR AI Tools Directory",
  "version": "1.0.0",
  "compatibility": {
    "starter": ">=1.2.0 <2.0.0",
    "addonApi": 1
  },
  "themes": [
    {
      "id": "vector-ai-tools",
      "name": "VECTOR",
      "entry": "src/theme.ts"
    }
  ],
  "templates": [
    {
      "id": "vector-ai-tools",
      "name": "VECTOR AI Tools",
      "renderer": "src/template.tsx",
      "templateApi": 1,
      "stylesheet": "src/template.css",
      "supportedProfiles": [
        {
          "id": "vector-ai-tools.ai-tools",
          "range": "^1.0.0"
        }
      ]
    }
  ],
  "profiles": [
    {
      "id": "vector-ai-tools.ai-tools",
      "version": "1.0.0",
      "schema": "src/ai-tools.profile.json"
    }
  ],
  "assets": [
    "public/diagrams/stack-map.svg",
    "public/marks/agent-relay.svg",
    "public/marks/arc-forge.svg",
    "public/marks/briefly.svg",
    "public/marks/codepilot-local.svg",
    "public/marks/data-lens.svg",
    "public/marks/pixel-flow.svg",
    "public/marks/shadow-preview.svg",
    "public/marks/signal-lab.svg",
    "public/marks/voice-mesh.svg",
    "public/vector-mark.svg"
  ],
  "seed": "seed/catalog.json",
  "files": [
    "docs/changelog.md",
    "docs/license.md",
    "docs/readme.md",
    "public/diagrams/stack-map.svg",
    "public/marks/agent-relay.svg",
    "public/marks/arc-forge.svg",
    "public/marks/briefly.svg",
    "public/marks/codepilot-local.svg",
    "public/marks/data-lens.svg",
    "public/marks/pixel-flow.svg",
    "public/marks/shadow-preview.svg",
    "public/marks/signal-lab.svg",
    "public/marks/voice-mesh.svg",
    "public/vector-mark.svg",
    "seed/catalog.json",
    "src/ai-tools.profile.json",
    "src/template.css",
    "src/template.tsx",
    "src/theme.ts"
  ]
}
