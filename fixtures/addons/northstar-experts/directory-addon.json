{
  "schemaVersion": 1,
  "id": "northstar-experts",
  "name": "NORTHSTAR Experts Directory",
  "version": "1.0.0",
  "compatibility": {
    "starter": ">=1.2.0 <2.0.0",
    "addonApi": 1
  },
  "themes": [
    {
      "id": "northstar-experts",
      "name": "NORTHSTAR",
      "entry": "src/theme.ts"
    }
  ],
  "templates": [
    {
      "id": "northstar-experts",
      "name": "NORTHSTAR Experts Directory",
      "renderer": "src/template.tsx",
      "templateApi": 1,
      "stylesheet": "src/template.css",
      "supportedProfiles": [
        {
          "id": "northstar-experts.experts",
          "range": "^1.0.0"
        }
      ]
    }
  ],
  "profiles": [
    {
      "id": "northstar-experts.experts",
      "version": "1.0.0",
      "schema": "src/experts.profile.json"
    }
  ],
  "assets": [
    "public/northstar-mark.svg"
  ],
  "seed": "seed/catalog.json",
  "files": [
    "docs/changelog.md",
    "docs/license.md",
    "docs/readme.md",
    "public/northstar-mark.svg",
    "seed/catalog.json",
    "seed/media/amina-okafor.webp",
    "seed/media/elena-petrov.webp",
    "seed/media/jonah-reed.webp",
    "seed/media/lucas-alvarez.webp",
    "seed/media/maya-chen.webp",
    "seed/media/priya-nair.webp",
    "seed/media/samira-haddad.webp",
    "seed/media/theo-martin.webp",
    "src/experts.profile.json",
    "src/template.css",
    "src/template.tsx",
    "src/theme.ts"
  ]
}
