{
  "schemaVersion": 1,
  "id": "borough-city-guide",
  "name": "BOROUGH Local City Guide",
  "version": "1.0.0",
  "compatibility": {
    "starter": ">=1.2.0 <2.0.0",
    "addonApi": 1
  },
  "themes": [
    {
      "id": "borough-city-guide",
      "name": "BOROUGH",
      "entry": "src/theme.ts"
    }
  ],
  "templates": [
    {
      "id": "borough-city-guide",
      "name": "BOROUGH Local City Guide",
      "renderer": "src/template.tsx",
      "templateApi": 1,
      "stylesheet": "src/template.css",
      "supportedProfiles": [
        {
          "id": "borough-city-guide.places",
          "range": "^1.0.0"
        }
      ]
    }
  ],
  "profiles": [
    {
      "id": "borough-city-guide.places",
      "version": "1.0.0",
      "schema": "src/places.profile.json"
    }
  ],
  "assets": [
    "public/borough-mark.svg"
  ],
  "seed": "seed/catalog.json",
  "files": [
    "docs/changelog.md",
    "docs/license.md",
    "docs/readme.md",
    "public/borough-mark.svg",
    "seed/catalog.json",
    "seed/media/atlas-books.webp",
    "seed/media/borough-market.webp",
    "seed/media/common-thread-studio.webp",
    "seed/media/courtyard-cinema.webp",
    "seed/media/ember-house.webp",
    "seed/media/marrow-and-mint.webp",
    "seed/media/northline-gallery.webp",
    "seed/media/riverlight-baths.webp",
    "seed/media/songbird-records.webp",
    "src/places.profile.json",
    "src/template.css",
    "src/template.tsx",
    "src/theme.ts"
  ]
}
