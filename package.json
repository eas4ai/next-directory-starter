    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.49.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
