# Copy to .env.docker, keep it private, and set real deployment values.
SITE_URL=https://directory.example.com
BETTER_AUTH_URL=https://directory.example.com
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# The Compose port is loopback only; put a reverse proxy in front of it.
DIRECTORY_PORT=3000
# Optional integrations use the same variable names as .env.example.
# Keep BILLING_ENCRYPTION_KEY stable if you save payment provider profiles.
